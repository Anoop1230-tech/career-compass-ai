APP_NAME=Career Compass AI API

# development | production | test
# production: requires a real SECRET_KEY, sends HSTS, sets Secure cookies,
#             runs Alembic migrations on start, and serves the built frontend.
ENVIRONMENT=development

# Database. Development uses a local SQLite file.
DATABASE_URL=sqlite:///./career_compass.db
# Production example (PostgreSQL). "postgres://" URLs from hosts are accepted too.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/career_compass

# Origins allowed to call the API from a different domain. In production the
# backend serves the frontend on the same origin, so this can usually stay empty.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Signs login tokens. MUST be a long random value in production (app refuses to start otherwise).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Brute-force protection for login/register (per IP address)
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# Mentor chat: messages per user per minute
MENTOR_RATE_LIMIT=30

# Serve the built React app (frontend/dist) from this server.
# Leave unset: on automatically when ENVIRONMENT=production. Force with true/false.
# SERVE_FRONTEND=true

# Load datasets/*.csv into the database on startup when they change
AUTO_SEED=true

# Optional: let a language model rephrase mentor answers (OpenAI-compatible chat completions API).
# Leave empty to keep the mentor fully offline. Enabling sends the question and a short profile
# summary (stage, goals, interests - no email or password) to the provider.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
