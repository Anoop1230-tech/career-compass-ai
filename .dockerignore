# Keep the build context small and never copy secrets or local state into the image.
**/__pycache__/
**/*.pyc
**/.pytest_cache/
backend/venv/
backend/*.db
backend/*.sqlite3
# Development-only code (the server never imports these)
backend/tests/
backend/ml/
backend/requirements-dev.txt
frontend/e2e/

# Secrets and env files (the image gets config from environment variables)
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
credentials*.json

# Node / build artifacts (frontend is built inside the image)
**/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/

# Docs, tooling, VCS
.git/
.gitignore
screenshots/
*.md
